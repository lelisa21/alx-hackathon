{
  "description": "Example LTI 1.3 launch flow with id_token payload and platform response",
  "login_request": {
    "endpoint": "POST /v1/lti/login",
    "body": {
      "iss": "https://lms.example.com",
      "client_id": "dimts-client-prod-123",
      "login_hint": "learner-456@lms.example.com",
      "target_link_uri": "https://app.example.com/lti/launch",
      "lti_message_hint": "course-789-lesson-012"
    }
