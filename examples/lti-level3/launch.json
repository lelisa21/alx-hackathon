      "nonce": "a1b2c3d4e5f6789012345678abcdef12",
      "authLoginUrl": "https://lms.example.com/oidc/authorize",
      "redirectUri": "https://api.example.com/v1/lti/launch"
    }
  },
  "platform_auth_flow": {
    "step_1": "Learner redirected to platform auth with state, nonce, client_id",
    "step_2": "Platform authenticates learner (password, SSO, etc.)",
    "step_3": "Platform builds id_token JWT with learner claims",
    "step_4": "Platform signs JWT with platform's private key",
    "step_5": "Platform redirects to /v1/lti/launch with id_token and state"
  },
  "id_token_payload": {
    "description": "JWT payload (unsigned example; production must be signed)",
    "iss": "https://lms.example.com",
    "aud": "dimts-client-prod-123",
    "sub": "learner-456",
    "exp": 1730950200,
    "iat": 1730949900,
    "nonce": "a1b2c3d4e5f6789012345678abcdef12",
    "https://purl.imsglobal.org/spec/lti/claim/deployment_id": "deployment-prod-001",
    "https://purl.imsglobal.org/spec/lti/claim/roles": [
      "http://purl.imsglobal.org/vocab/lis/v2/institution/person#Learner"
    ],
    "https://purl.imsglobal.org/spec/lti/claim/context": {
      "id": "course-789",
      "label": "CHEM101",
      "title": "General Chemistry I"
    }
  },
  "id_token_payload_instructor": {
    "description": "Same as above but with Instructor role for insights access",
    "iss": "https://lms.example.com",
    "aud": "dimts-client-prod-123",
