      "http://purl.imsglobal.org/vocab/lis/v2/institution/person#Instructor"
    ],
    "https://purl.imsglobal.org/spec/lti/claim/context": {
      "id": "course-789",
      "label": "CHEM101",
      "title": "General Chemistry I"
    }
  },
  "launch_request": {
    "endpoint": "POST /v1/lti/launch",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "id_token": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..SIGNATURE_HASH",
      "state": "eyJwbGF0Zm9ybUlkIjoicGxhdGZvcm0tMDAxIiwidGltZXN0YW1wIjoxNzMwOTQ5NjAwfQ"
