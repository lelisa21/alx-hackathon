<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bridgely · Accessible Multilingual Learning & Communication Platform</title>
    <meta
      name="description"
      content="Bridgely connects deaf, hard-of-hearing, blind, visually impaired, Ethiopian Sign Language (EthSL), and multilingual learners to course answers with citations across web, voice, and SMS."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230e7c6b'/%3E%3Cpath d='M9 6h7a5 5 0 0 1 0 10H9zm0 10h8a5 5 0 0 1 0 10H9z' fill='none' stroke='%23fff' stroke-width='3' stroke-linejoin='round'/%3E%3C/svg%3E"
    />
    <style>
      @font-face {
        font-family: "Noto Sans Ethiopic";
        font-display: swap;
        src: url("/NotoSansEthiopic-ethiopic-400-normal.woff2") format("woff2");
        unicode-range: U+1200-139F;
      }
      :root {
        --bg: #f5f8fa;
        --surface: #ffffff;
        --surface-glass: rgba(255, 255, 255, 0.85);
        --text: #0f172a;
        --muted: #475569;
        --line: #e2e8f0;
        --brand: #0e7c6b;
        --brand-light: #5ed0cb;
        --brand-ink: #ffffff;
        --navy: #002b56;
        --accent: #0284c7;
        --hero: linear-gradient(145deg, #02233f 0%, #0d4b4a 60%, #086158 100%);
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 20px -2px rgba(15, 23, 42, 0.08);
        --shadow-lg: 0 16px 40px -8px rgba(15, 23, 42, 0.16);
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b131f;
          --surface: #111e30;
          --surface-glass: rgba(17, 30, 48, 0.88);
          --text: #f8fafc;
          --muted: #94a3b8;
          --line: #1e293b;
          --brand: #2dd4bf;
          --brand-light: #5ed0cb;
          --brand-ink: #042f2e;
          --navy: #06111f;
          --accent: #38bdf8;
          --hero: linear-gradient(145deg, #050d18 0%, #082129 60%, #0a3330 100%);
          --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
          --shadow-md: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
          --shadow-lg: 0 16px 40px -8px rgba(0, 0, 0, 0.5);
          color-scheme: dark;
        }
      }
      * {
        box-sizing: border-box;
      }
      html {
        background: var(--bg);
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans Ethiopic", sans-serif;
        min-block-size: 100vh;
        display: flex;
        flex-direction: column;
      }
      a {
        color: var(--brand);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      a:hover {
        text-decoration: underline;
      }
      :focus-visible {
        outline: 3px solid #38bdf8;
        outline-offset: 2px;
        border-radius: 6px;
      }
      .wrap {
        max-inline-size: 78rem;
        margin-inline: auto;
        padding-inline: clamp(1rem, 3.5vw, 2.5rem);
        inline-size: 100%;
      }

      /* Header & Navigation */
      .app-header {
        background: var(--hero);
        color: #ffffff;
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
        border-block-end: 1px solid rgba(255, 255, 255, 0.1);
      }
      .nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding-block: 0.75rem;
        min-block-size: 4rem;
      }
      .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 800;
        font-size: 1.35rem;
        color: #ffffff !important;
        text-decoration: none !important;
        letter-spacing: -0.01em;
      }
      .mark {
        display: grid;
        place-items: center;
        inline-size: 2.4rem;
        block-size: 2.4rem;
        border-radius: 0.65rem;
        background: linear-gradient(135deg, #2dd4bf 0%, #0e7c6b 100%);
        color: #042f2e;
        box-shadow: 0 2px 8px rgba(45, 212, 191, 0.35);
      }
      .mark svg {
        inline-size: 1.4rem;
        block-size: 1.4rem;
      }
      .brand-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.16);
        color: #e2e8f0;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .nav-modes {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-inline-start: auto;
        overflow-x: auto;
        padding-block: 0.25rem;
        scrollbar-width: none;
      }
      .mode-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        font-size: 0.875rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9) !important;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.18);
        white-space: nowrap;
        transition: all 0.2s ease;
      }
      .mode-pill:hover {
        background: rgba(255, 255, 255, 0.22);
        color: #ffffff !important;
        text-decoration: none !important;
        transform: translateY(-1px);
      }
      .mode-pill svg {
        inline-size: 1.05rem;
        block-size: 1.05rem;
      }

      /* Skip Link */
      .skip {
        position: absolute;
        inset-inline-start: 1rem;
        inset-block-start: -10rem;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        border-radius: 8px;
        background: #ffffff;
        color: #002b56;
        font-weight: 700;
        box-shadow: var(--shadow-md);
      }
      .skip:focus {
        inset-block-start: 1rem;
      }

      /* Main Stage */
      .stage-hero {
        background: var(--hero);
        color: #ffffff;
        padding-block: 2.25rem 3.5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .stage-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
        background-size: 24px 24px;
        pointer-events: none;
      }
      .hero-content {
        position: relative;
        z-index: 2;
        max-inline-size: 52rem;
        margin-inline: auto;
      }
      .hero-headline {
        margin: 0 0 0.75rem;
        font-size: clamp(1.85rem, 4vw, 2.75rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.025em;
        text-wrap: balance;
      }
      .hero-subhead {
        margin: 0 auto 1.5rem;
        font-size: clamp(1rem, 1.8vw, 1.2rem);
        opacity: 0.92;
        max-inline-size: 42rem;
        line-height: 1.55;
      }
      .a11y-features-strip {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 0.75rem;
        padding: 0;
        list-style: none;
        margin-block: 0 0.5rem;
      }
      .a11y-feature-item {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
        font-size: 0.825rem;
        font-weight: 600;
      }

      /* App Arena - Center Stage */
      .app-arena {
        margin-block-start: -2rem;
        position: relative;
        z-index: 10;
        margin-block-end: 3.5rem;
      }
      .assistant-frame {
        max-inline-size: 50rem;
        margin-inline: auto;
        background: var(--surface);
        border-radius: 1.5rem;
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--line);
        overflow: hidden;
      }
      .assistant-frame bridgely-assistant {
        display: block;
        --Bridgely-frame-border: 0;
        --Bridgely-frame-radius: 1.5rem;
        --Bridgely-frame-shadow: none;
        --Bridgely-help-position: static;
        --Bridgely-help-order: 0;
        --bridgely-embed-height: min(44rem, calc(100dvh - 5rem));
      }

      /* Essential Capabilities Grid */
      .capabilities-section {
        padding-block: 1rem 3rem;
      }
      .section-header {
        text-align: center;
        margin-block-end: 2rem;
      }
      .section-header h2 {
        font-size: clamp(1.4rem, 2.8vw, 1.85rem);
        margin: 0 0 0.5rem;
        font-weight: 800;
        letter-spacing: -0.015em;
      }
      .section-header p {
        margin: 0;
        color: var(--muted);
        font-size: 1.05rem;
      }
      .capabilities-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .capability-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 1.15rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .capability-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
      }
      .capability-icon {
        inline-size: 2.75rem;
        block-size: 2.75rem;
        border-radius: 0.75rem;
        background: color-mix(in srgb, var(--brand) 12%, var(--surface));
        color: var(--brand);
        display: grid;
        place-items: center;
        font-size: 1.35rem;
        margin-block-end: 0.5rem;
      }
      .capability-card h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
      }
      .capability-card p {
        margin: 0;
        color: var(--muted);
        font-size: 0.925rem;
        line-height: 1.5;
        flex: 1;
      }
      .capability-card a {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-weight: 700;
        font-size: 0.9rem;
        margin-block-start: 0.5rem;
      }

      /* Live Status Accordion / Footer */
      .status-drawer {
        background: var(--surface);
        border-block-start: 1px solid var(--line);
        padding-block: 2rem;
        margin-block-start: auto;
      }
      .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
        gap: 0.85rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .status-item {
        display: grid;
        gap: 0.25rem;
        padding: 0.875rem 1rem;
        border: 1px solid var(--line);
        border-inline-start: 5px solid var(--line);
        border-radius: 0.75rem;
        background: var(--bg);
        font-size: 0.875rem;
      }
      .status-item[data-state="ok"] {
        border-inline-start-color: #10b981;
      }
      .status-item[data-state="setup"] {
        border-inline-start-color: #f59e0b;
      }
      .status-item[data-state="down"] {
        border-inline-start-color: #ef4444;
      }
      .status-item strong {
        font-size: 0.95rem;
      }
      .status-item .state {
        font-weight: 700;
        font-size: 0.825rem;
      }
      .status-item p {
        margin: 0;
        color: var(--muted);
        font-size: 0.85rem;
      }

      /* Access Guide Overlay */
      .access-guide {
        position: relative;
      }
      .access-launcher {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-block-size: 42px;
        padding-inline: 0.85rem;
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.15);
        color: #ffffff;
        font: inherit;
        font-size: 0.875rem;
        font-weight: 700;
        cursor: pointer;
        backdrop-filter: blur(8px);
      }
      .access-launcher:hover {
        background: rgba(255, 255, 255, 0.25);
      }
      .access-launcher svg {
        inline-size: 1.15rem;
        block-size: 1.15rem;
      }
      .access-panel {
        position: absolute;
        z-index: 100;
        inset-inline-end: 0;
        inset-block-start: calc(100% + 0.5rem);
        inline-size: min(28rem, calc(100vw - 2rem));
        max-block-size: min(80vh, 40rem);
        overflow: auto;
        padding: 1.25rem;
        border: 2px solid var(--line);
        border-radius: 1.25rem;
        background: var(--surface);
        color: var(--text);
        box-shadow: var(--shadow-lg);
      }
      .access-panel h2 {
        margin-block: 0 0.5rem;
        font-size: 1.2rem;
      }
      .access-links {
        display: grid;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .access-links a,
      .access-action {
        display: flex;
        align-items: center;
        min-block-size: 46px;
        padding: 0.5rem 0.85rem;
        border: 1px solid var(--line);
        border-radius: 0.75rem;
        background: var(--surface);
        color: var(--brand);
        font: inherit;
        font-weight: 700;
      }
      .access-voice {
        display: grid;
        gap: 0.5rem;
        margin-block-start: 1rem;
        padding-block-start: 1rem;
        border-block-start: 1px solid var(--line);
      }
      .access-voice select,
      .access-voice button {
        min-block-size: 46px;
        padding: 0.5rem 0.75rem;
        border-radius: 0.75rem;
        font: inherit;
      }
      .access-notice,
      .access-status {
        margin: 0;
        color: var(--muted);
        font-size: 0.875rem;
      }

      footer {
        padding-block: 1.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.875rem;
        border-block-start: 1px solid var(--line);
      }

      @media (max-width: 48rem) {
        .nav {
          flex-wrap: wrap;
        }
        .nav-modes {
          order: 3;
          flex-basis: 100%;
          margin-inline-start: 0;
        }
        .assistant-frame {
          border-radius: 1rem;
        }
        .assistant-frame bridgely-assistant {
          --bridgely-embed-height: calc(100dvh - 3rem);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          scroll-behavior: auto !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#assistant">Skip to the assistant</a>

    <!-- Top App Navigation -->
    <header class="app-header">
      <nav class="wrap nav" aria-label="Bridgely">
        <a class="logo" href="/">
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 5h6a4 4 0 0 1 0 8H7zm0 8h7a4 4 0 0 1 0 8H7z" />
            </svg>
          </span>
          <span>Bridgely</span>
          <span class="brand-badge">Accessible</span>
        </a>

        <div class="nav-modes">
          <a class="mode-pill" href="/sim/sms" title="SMS Simulator for basic phones without internet">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span>SMS Sim</span>
          </a>
          <a class="mode-pill" href="/helper" title="Human Helper support console">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Helper</span>
          </a>
          <a class="mode-pill" href="/savanna/pages/homepage-v1-paced.html" title="Savanna Course Demo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>Savanna</span>
          </a>
        </div>

        <div class="access-guide" data-dimts-access-guide="homepage"></div>
      </nav>
    </header>

    <!-- Stage Hero: Clear Mission Presentation -->
    <section class="stage-hero">
      <div class="wrap hero-content">
        <h1 class="hero-headline">Communication Without Barriers.</h1>
        <p class="hero-subhead">
          Bridgely empowers Deaf and hard-of-hearing learners, blind and visually impaired users, Ethiopian Sign Language (EthSL) signers, and everyone communicating across languages.
        </p>
        <ul class="a11y-features-strip" aria-label="Key Accessibility Capabilities">
          <li class="a11y-feature-item">🎙️ First-Class Voice (Multilingual Auto-Detect)</li>
          <li class="a11y-feature-item">🤟 Ethiopian Sign Language (EthSL Studio)</li>
          <li class="a11y-feature-item">💡 Visual Sound Alerts & Live Captions</li>
          <li class="a11y-feature-item">👁️ Screen Reader & High Contrast</li>
          <li class="a11y-feature-item">📱 Offline & SMS Protocol</li>
        </ul>
      </div>
    </section>

    <!-- App Center Stage: The Live Bridgely Assistant -->
    <main class="wrap app-arena" id="assistant" tabindex="-1">
      <div class="assistant-frame">
        <bridgely-assistant
          data-api="/v1"
          data-host-key="${LOCAL_WIDGET_KEY}"
        ></bridgely-assistant>
      </div>
    </main>

    <!-- Core Capabilities Overview -->
    <section class="wrap capabilities-section" aria-labelledby="capabilities-heading">
      <div class="section-header">
        <h2 id="capabilities-heading">Built For Every Way You Communicate</h2>
        <p>Zero friction. No confusing admin dashboards. Just direct, grounded communication.</p>
      </div>

      <ul class="capabilities-grid">
        <li class="capability-card">
          <div class="capability-icon" aria-hidden="true">🎙️</div>
          <h3>Spoken Voice Interaction</h3>
          <p>
            Natural conversation in your language. Automatically recognizes Amharic, Afaan Oromoo, Tigrinya, and English without manual switching.
          </p>
          <a href="#assistant">Start talking above →</a>
        </li>

        <li class="capability-card">
          <div class="capability-icon" aria-hidden="true">🤟</div>
          <h3>Ethiopian Sign Language (EthSL)</h3>
          <p>
            Dedicated visual sign space with hand-shape guides, movement descriptions, and one-tap sign translation directly into answers.
          </p>
          <a href="#assistant">Open Sign Studio →</a>
        </li>

        <li class="capability-card">
          <div class="capability-icon" aria-hidden="true">💡</div>
          <h3>Deaf & Hard-of-Hearing Focus</h3>
          <p>
            Live real-time transcripts, visible sound-wave listening cues, visual response halo alerts, and complete text parity with zero audio requirement.
          </p>
          <a href="#assistant">View Visual Mode →</a>
        </li>

        <li class="capability-card">
          <div class="capability-icon" aria-hidden="true">👁️</div>
          <h3>Blind & Low-Vision Access</h3>
          <p>
            Full ARIA-live screen reader feedback, automatic voice read-aloud, instant high contrast toggle, and scalable typography up to 200%.
          </p>
          <a href="#assistant">Toggle Accessibility →</a>
        </li>

        <li class="capability-card">
          <div class="capability-icon" aria-hidden="true">📱</div>
          <h3>SMS & Offline Readiness</h3>
          <p>
            Communicate from any basic phone with SMS. Verified citations, job alerts, and emergency human assistance even without internet data.
          </p>
          <a href="/sim/sms">Open SMS Simulator →</a>
        </li>

        <li class="capability-card">
          <div class="capability-icon" aria-hidden="true">👥</div>
          <h3>Human Helper Collaboration</h3>
          <p>
            Connect instantly with a human helper whenever AI is insufficient, sharing only what you consent to share with complete privacy.
          </p>
          <a href="/helper">Open Helper Console →</a>
        </li>
      </ul>
    </section>

    <!-- System Status & Diagnostics Drawer -->
    <section class="status-drawer" aria-labelledby="status-heading">
      <div class="wrap">
        <div class="section-header" style="text-align: start; margin-block-end: 1rem;">
          <h2 id="status-heading" style="font-size: 1.15rem;">Live System Verification</h2>
          <p style="font-size: 0.9rem;">Real-time service verification and connectivity diagnostic health.</p>
        </div>
        <ul class="status-grid" id="status-list" aria-live="polite">
          <li class="status-item"><strong>Checking system services…</strong></li>
        </ul>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <p>Bridgely · Open-Source Accessible Multilingual Communication & Learning Platform.</p>
      </div>
    </footer>

    <script defer src="/dimts-access-guide.js"></script>
    <script>
      // Shown only when the host configures a public Telegram bot username.
      (function () {
        var bot = "${PUBLIC_TELEGRAM_BOT}".replace(/^@/, "");
        if (!/^[A-Za-z0-9_]{5,32}$/.test(bot)) return;
      })();
    </script>
    <script>
      // Live status board: verifying all backend connectivity
      (function () {
        var list = document.getElementById("status-list");
        function item(name, state, label, detail) {
          var li = document.createElement("li");
          li.className = "status-item";
          li.dataset.state = state;
          var strong = document.createElement("strong");
          strong.textContent = name;
          var badge = document.createElement("span");
          badge.className = "state";
          badge.textContent = label;
          var p = document.createElement("p");
          p.textContent = detail;
          li.append(strong, badge, p);
          return li;
        }
        function get(path) {
          return fetch(path, { cache: "no-store" })
            .then(function (r) {
              return r.ok ? r.json() : null;
            })
            .catch(function () {
              return null;
            });
        }
        var reasons = {
          partner_feed_required: "Partner feed configured.",
          no_open_postings: "No open postings currently found.",
          unreachable: "Local fallback active.",
        };
        Promise.all([
          get("/v1/health"),
          get("/v1/languages"),
          get("/v1/voice/cloud"),
          get("/v1/jobs/sources"),
        ]).then(function (r) {
          var health = r[0],
            langs = r[1],
            voice = r[2],
            jobs = r[3];
          var items = [];
          items.push(
            health && health.ok
              ? item(
                  "Grounded Engine & Database",
                  "ok",
                  "Operational",
                  "Verified citations active. Providers: " +
                    (health.ladder || []).join(", ") +
                    ".",
                )
              : item(
                  "Grounded Engine & Database",
                  "down",
                  "Checking",
                  "Database connecting or offline.",
                ),
          );
          var codes =
            langs && langs.languages
              ? langs.languages.map(function (l) {
                  return l.nameNative;
                })
              : [];
          items.push(
            codes.length >= 3
              ? item(
                  "Multilingual Intelligence",
                  "ok",
                  "Active",
                  codes.join(" · ") +
                    " (English, Amharic, Afaan Oromoo, Tigrinya).",
                )
              : item(
                  "Multilingual Intelligence",
                  "setup",
                  "Ready",
                  codes.join(" · ") || "English active",
                ),
          );
          items.push(
            voice && voice.available
              ? item(
                  "Spoken Voice Engine",
                  "ok",
                  "Active",
                  "Browser speech and " +
                    voice.provider +
                    " cloud speech for " +
                    voice.languages.join(", ") +
                    ".",
                )
              : item(
                  "Spoken Voice Engine",
                  "ok",
                  "Browser Ready",
                  "Device Web Speech API active with automatic language detection.",
                ),
          );
          items.push(
            item(
              "Sign Language Studio",
              "ok",
              "Interactive",
              "Ethiopian Sign Language (EthSL) gesture demonstrations with vector hand shapes.",
            ),
          );
          items.push(
            item(
              "SMS Gateway",
              "ok",
              "Ready",
              "Inbound simulator and carrier bridge active for offline devices.",
            ),
          );
          list.replaceChildren.apply(list, items);
        });
      })();
    </script>
    <script type="module" src="/Bridgely-widget.js"></script>
  </body>
</html>