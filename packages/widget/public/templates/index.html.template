<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dimts</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23164e63'/%3E%3Cpath d='M9 8h7a8 8 0 0 1 0 16H9z' fill='none' stroke='%23fff' stroke-width='3'/%3E%3C/svg%3E"
    />
    <style>
      html {
        background: #eef3f5;
      }
      body {
        margin: 0;
        min-block-size: 100dvh;
        padding: 1.5rem 1rem 6rem;
        box-sizing: border-box;
      }
      @media (prefers-color-scheme: dark) {
        html {
          background: #0a141f;
        }
      }
    </style>
  </head>
  <body>
    <dimts-assistant
      data-api="/v1"
      data-host-key="${DIMTS_LOCAL_WIDGET_KEY}"
    ></dimts-assistant>
    <script type="module" src="/dimts-widget.js"></script>
  </body>
</html>
