{
  "name": "@dimts/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node dist/openapi-cli.js",
    "migrate": "node --env-file-if-exists=../../.env dist/db/migrate.js",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.2.0",
    "@dimts/ai": "workspace:*",
    "@dimts/engine": "workspace:*",
    "@dimts/grounding": "workspace:*",
    "@dimts/locales-tools": "workspace:*",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.10",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "yaml": "^2.7.0",
    "pg": "^8.13.3",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.14",
    "supertest": "^7.0.0"
  }
}
