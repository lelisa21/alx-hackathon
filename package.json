{
  "name": "dimts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.12.1"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "api:start": "pnpm --filter @dimts/api build && pnpm --filter @dimts/api start",
    "migrate": "pnpm --filter @dimts/api build && pnpm --filter @dimts/api migrate",
    "local:bootstrap": "pnpm --filter @dimts/api build && pnpm --filter @dimts/api bootstrap:local",
    "content:ingest": "pnpm --filter @dimts/engine build && pnpm --filter @dimts/grounding build && node --env-file-if-exists=.env packages/grounding/dist/cli.js",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm build && vitest run --passWithNoTests",
    "verify:phases-1-6": "node scripts/verify-phases-1-6.mjs",
    "test:lang": "vitest run --config vitest.locales.config.ts --coverage",
    "test:core": "vitest run --config vitest.core.config.ts --coverage",
    "eval": "pnpm --filter @dimts/eval... build && node packages/eval/dist/cli.js",
    "test:compose": "node scripts/test-local-compose.mjs",
    "test:widget": "pnpm --filter @dimts/widget build && playwright test --config playwright.widget.config.ts",
    "lint": "eslint . && pnpm lint:styles && pnpm lint:strings",
    "lint:styles": "stylelint \"packages/widget/src/**/*.css\" --allow-empty-input",
    "lint:strings": "node scripts/no-literal-strings.mjs",
    "lang:check": "pnpm --filter @dimts/locales-tools build && node packages/locales-tools/dist/cli.js",
    "lang:new": "pnpm --filter @dimts/locales-tools build && node packages/locales-tools/dist/new-cli.js",
    "size": "node scripts/size-gate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "stylelint": "^16.16.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
