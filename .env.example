# Dimts API environment template. Copy to .env and fill in.
# Every variable is documented in docs/ENVIRONMENT.md: what it does, where to
# get the value, and what production needs. Never commit this file.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
DIMTS_COMPOSE_API_PORT=3000
DIMTS_COMPOSE_WEB_PORT=5173

# --- Database --------------------------------------------------------------
# docker compose runs its own Postgres with this password (the local volume
# was created with it; changing it locks the API out of the existing data).
POSTGRES_PASSWORD=replace-with-a-local-password
# Used only when running the API outside docker (compose overrides both).
DATABASE_URL=postgres://dimts:replace-with-a-local-password@localhost:5432/dimts
DATABASE_URL_DIRECT=postgres://dimts:replace-with-a-local-password@localhost:5432/dimts

# --- Secrets (generate once; see docs/ENVIRONMENT.md for the commands) -------
DIMTS_ENC_KEY=generate-with-openssl-rand-base64-32
DIMTS_HASH_KEY=generate-a-different-openssl-rand-base64-32
DIMTS_JWT_SECRET=generate-a-third-distinct-secret-at-least-32-characters
DIMTS_CRON_SECRET=generate-with-openssl-rand-base64-24
DIMTS_SEED_HELPER_TOKEN=

# --- Hosts and content ------------------------------------------------------
# Comma list of every page origin that embeds the widget (scheme://host:port).
DIMTS_HOST_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public widget key (not a secret) that the local web container uses.
DIMTS_LOCAL_WIDGET_KEY=local-widget-public-id
DIMTS_DEFAULT_LANG=en
DIMTS_PREVIEW_LANGS=am,om
DIMTS_CONTENT_BASE_URL=http://localhost:5173/learn/
# Extra public websites to index (JSON list). [] = only content/savanna.
DIMTS_PUBLIC_SOURCES=[]
DIMTS_SOURCE_SYNC_INTERVAL_MS=300000
DIMTS_RETENTION_HOURS=24
# Public base URL of this API, used to register the Telegram webhook in
# production. Empty locally (Telegram uses polling).
DIMTS_PUBLIC_API_URL=

# --- AI answers --------------------------------------------------------------
# Ladder: Gemini (gemini-4-hydrogen) -> OpenRouter free models -> offline.
# Remote AI runs only after the learner allows it in the widget.
# GEMINI_API_KEY: https://aistudio.google.com/apikey (starts with "AIza").
# While it is a placeholder the API logs ai_provider_disabled and skips Gemini.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# OPENROUTER_API_KEY: https://openrouter.ai/settings/keys (starts with "sk-or-").
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY
DIMTS_AI_PROVIDER=gemini
DIMTS_AI_LADDER=gemini,openrouter,offline
# Model IDs live here (GEMINI_MODEL / OPENROUTER_MODEL are not read by Dimts).
# OpenRouter tries particle-1, then ling-3.2-flash, then nemotron-3.5 (all
# ":free"); they were chosen because they answer Amharic and Afaan Oromoo and
# decline off-topic passages. Gemma ":free" is often rate limited upstream.
DIMTS_AI_PROVIDERS=[{"id":"gemini","adapter":"gemini","model":"gemini-4-hydrogen","credentialRef":"GEMINI_API_KEY","privacyClass":"remote","enabled":true,"priority":1,"timeoutMs":12000,"allowedDataClasses":["question","course-passage","job-posting"],"evaluatedLanguages":[],"capabilities":{"languages":["en","am","om"],"modes":["extractive","generative"],"modalities":["text"],"structuredOutput":true}},{"id":"openrouter","adapter":"openrouter","model":"particle-ai/particle-1:free","fallbackModels":["inclusionai/ling-3.2-flash:free","nvidia/nemotron-3.5-super-vl:free"],"credentialRef":"OPENROUTER_API_KEY","privacyClass":"remote","enabled":true,"priority":2,"timeoutMs":15000,"allowedDataClasses":["question","course-passage","job-posting"],"evaluatedLanguages":[],"capabilities":{"languages":["en","am","om"],"modes":["extractive","generative"],"modalities":["text"],"structuredOutput":true}}]
DIMTS_AI_MAX_TOKENS=512
DIMTS_AI_TEMPERATURE=0.2
DIMTS_AI_RECALL_FLOOR=0.15
DIMTS_AI_CONSENT_VERSION=remote-ai-v1
DIMTS_LANGUAGE_DETECTION_CONFIDENCE=0.25

# --- Voice -------------------------------------------------------------------
# Browser speech where the device supports the language; Gemini cloud speech
# (after learner consent) for the rest. Cloud voice uses GEMINI_API_KEY:
# transcription on gemini-4-hydrogen, read-aloud on gemini-3.8-flash-lite-tts.
# Gemini TTS speaks English and Amharic, not Afaan Oromoo.
DIMTS_STT_ENGINE=browser
DIMTS_TTS_ENGINE=browser
DIMTS_CLOUD_VOICE=gemini
DIMTS_CLOUD_VOICE_LANGS=en,am,om
DIMTS_CLOUD_VOICE_SPEAK_LANGS=en,am
DIMTS_CLOUD_VOICE_STT_MODEL=gemini-4-hydrogen
DIMTS_CLOUD_VOICE_TTS_MODEL=gemini-3.8-flash-lite-tts
# Development only (production rejects it): skip the native-speaker review gate.
DIMTS_VOICE_PREVIEW=false

# --- Telegram ----------------------------------------------------------------
# Token from @BotFather. Locally the API polls; only ONE process may poll a
# token at a time (another one causes 409 Conflict in the log).
DIMTS_TELEGRAM_MODE=
DIMTS_TELEGRAM_TOKEN=
DIMTS_TELEGRAM_SECRET=
DIMTS_PUBLIC_TELEGRAM_BOT=

# --- SMS ---------------------------------------------------------------------
# simulator: the /sim/sms page, no real network. For real SMS set
# DIMTS_SMS_MODE=smsethiopia and DIMTS_SMS_GATEWAY_TOKEN to the SMS Ethiopia
# campaign API key (https://smsethiopia.com, Console > API Keys).
DIMTS_SMS_MODE=simulator
DIMTS_SMS_GATEWAY_SECRET=
DIMTS_SMS_GATEWAY_TOKEN=
DIMTS_SMS_GATEWAY_URL=
DIMTS_SMS_CALLBACK_URL=
DIMTS_SMS_CALLBACK_SECRET=
DIMTS_SMS_DAILY_LIMIT=20

# --- Jobs --------------------------------------------------------------------
# Ethiojobs is imported from its public job pages. HahuJobs and Afriwork have
# no public feed: they stay "needs_setup" until the platform gives a partner
# feed URL (DIMTS_HAHUJOBS_FEED_URL / DIMTS_AFRIWORK_FEED_URL).
DIMTS_JOB_SOURCES=ethiojobs,hahujobs,afriwork
DIMTS_JOB_SYNC_LIMIT=40
# Job alerts are delivered natively by the Telegram bot and SMS. Run the alert
# job in-process every hour (0 = only via POST /v1/internal/alerts cron).
DIMTS_JOBS_ALERT_INTERVAL_MS=3600000
# Relay = an optional delivery webhook on the HOST platform (e.g. an LMS that
# sends its own SMS). Dimts does not need it; leave all three empty.
DIMTS_JOBS_RELAY_URL=
DIMTS_JOBS_RELAY_SECRET=
DIMTS_JOBS_RELAY_CHANNELS=

# --- Human help ----------------------------------------------------------------
DIMTS_HELPER_HOURS=
DIMTS_HELP_WAIT_TIMEOUT_MS=300000
# Metered TURN for video help behind strict NATs: both values from
# https://dashboard.metered.ca (app subdomain + secret key), or both empty to
# use public STUN.
DIMTS_TURN_APP=
DIMTS_TURN_API_KEY=

# --- LTI 1.3 (local demo platform) -------------------------------------------
DIMTS_LTI_PLATFORMS=[]
DIMTS_LTI_WIDGET_URL=
DIMTS_LTI_WIDGET_KEY=
