# Bridgely API environment template. Copy to .env and fill in.
# Every variable is documented in docs/ENVIRONMENT.md: what it does, where to
# get the value, and what production needs. Never commit this file.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
COMPOSE_API_PORT=3000
COMPOSE_WEB_PORT=5173

# --- Database --------------------------------------------------------------
# docker compose runs its own Postgres with this password (the local volume
# was created with it; changing it locks the API out of the existing data).
POSTGRES_PASSWORD=replace-with-a-local-password
# Used only when running the API outside docker (compose overrides both).
DATABASE_URL=postgres://dimts:replace-with-a-local-password@localhost:5432/dimts
DATABASE_URL_DIRECT=postgres://dimts:replace-with-a-local-password@localhost:5432/dimts

# --- Secrets (generate once; see docs/ENVIRONMENT.md for the commands) -------
ENC_KEY=generate-with-openssl-rand-base64-32
HASH_KEY=generate-a-different-openssl-rand-base64-32
JWT_SECRET=generate-a-third-distinct-secret-at-least-32-characters
CRON_SECRET=generate-with-openssl-rand-base64-24
SEED_HELPER_TOKEN=

# --- Hosts and content ------------------------------------------------------
# Comma list of every page origin that embeds the widget (scheme://host:port).
HOST_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public widget key (not a secret) that the local web container uses.
LOCAL_WIDGET_KEY=local-widget-public-id
DEFAULT_LANG=en
PREVIEW_LANGS=am,om,ti
CONTENT_BASE_URL=http://localhost:5173/learn/
# Extra public websites to index (JSON list). [] = only content/savanna.
PUBLIC_SOURCES=[]
SOURCE_SYNC_INTERVAL_MS=300000
RETENTION_HOURS=24
# Public base URL of this API, used to register the Telegram webhook in
# production. Empty locally (Telegram uses polling).
PUBLIC_API_URL=

# --- AI answers --------------------------------------------------------------
# Ladder: gemini-3.8-flash -> gemini-3.6-flash -> gemini-3.5-flash-lite
# -> OpenRouter free models -> offline. A rate-limited model is skipped until
# Google's reported reset time.
# Remote AI runs only after the learner allows it in the widget.
# GEMINI_API_KEY: https://aistudio.google.com/apikey (starts with "AIza").
# While it is a placeholder the API logs ai_provider_disabled and skips Gemini.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# OPENROUTER_API_KEY: https://openrouter.ai/settings/keys (starts with "sk-or-").
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY
AI_PROVIDER=gemini
AI_LADDER=gemini,gemini-flash-lite,gemini-lite,openrouter,offline
# Model IDs live here (GEMINI_MODEL / OPENROUTER_MODEL are not read by Bridgely).
# OpenRouter tries particle-1, then ling-3.2-flash, then nemotron-3.5 (all
# ":free"); they were chosen because they answer Amharic and Afaan Oromoo and
# decline off-topic passages. Gemma ":free" is often rate limited upstream.
AI_PROVIDERS=[{"id":"gemini","adapter":"gemini","model":"gemini-3.6-flash","credentialRef":"GEMINI_API_KEY","privacyClass":"remote","enabled":true,"priority":1,"timeoutMs":12000,"allowedDataClasses":["question","course-passage","job-posting"],"evaluatedLanguages":["en","am","om","ti"],"capabilities":{"languages":["en","am","om","ti"],"modes":["extractive","generative"],"modalities":["text"],"structuredOutput":true}},{"id":"gemini-flash-lite","adapter":"gemini","model":"gemini-3.5-flash-lite","credentialRef":"GEMINI_API_KEY","privacyClass":"remote","enabled":true,"priority":2,"timeoutMs":8000,"allowedDataClasses":["question","course-passage","job-posting"],"evaluatedLanguages":["en","am","om","ti"],"capabilities":{"languages":["en","am","om","ti"],"modes":["extractive","generative"],"modalities":["text"],"structuredOutput":true}},{"id":"gemini-lite","adapter":"gemini","model":"gemini-3.1-flash-lite","credentialRef":"GEMINI_API_KEY","privacyClass":"remote","enabled":true,"priority":3,"timeoutMs":8000,"allowedDataClasses":["question","course-passage","job-posting"],"evaluatedLanguages":["en","am","om","ti"],"capabilities":{"languages":["en","am","om","ti"],"modes":["extractive","generative"],"modalities":["text"],"structuredOutput":true}},{"id":"openrouter","adapter":"openrouter","model":"particle-ai/particle-1:free","fallbackModels":["inclusionai/ling-3.2-flash:free","nvidia/nemotron-3.5-super-vl:free"],"credentialRef":"OPENROUTER_API_KEY","privacyClass":"remote","enabled":true,"priority":4,"timeoutMs":15000,"allowedDataClasses":["question","course-passage","job-posting"],"evaluatedLanguages":["en","am","om","ti"],"capabilities":{"languages":["en","am","om","ti"],"modes":["extractive","generative"],"modalities":["text"],"structuredOutput":true}}]
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_RECALL_FLOOR=0.15
AI_CONSENT_VERSION=remote-ai-v1
LANGUAGE_DETECTION_CONFIDENCE=0.25

# --- Voice -------------------------------------------------------------------
# Browser speech where the device supports the language; Gemini cloud speech
# (after learner consent) for the rest. Cloud voice uses GEMINI_API_KEY:
# transcription on gemini-3.8-flash, read-aloud on gemini-3.8-flash-lite-tts.
# Gemini TTS speaks English, Amharic and Tigrinya (Tigrinya only on
# gemini-3.8-flash-tts), not Afaan Oromoo.
STT_ENGINE=browser
TTS_ENGINE=browser
CLOUD_VOICE=gemini
CLOUD_VOICE_LANGS=en,am,om,ti
CLOUD_VOICE_SPEAK_LANGS=en,am,ti
CLOUD_VOICE_STT_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
CLOUD_VOICE_TTS_MODEL=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
# Development only (production rejects it): skip the native-speaker review gate.
VOICE_PREVIEW=false

# --- Telegram ----------------------------------------------------------------
# Token from @BotFather. Locally the API polls; only ONE process may poll a
# token at a time (another one causes 409 Conflict in the log).
TELEGRAM_MODE=
TELEGRAM_TOKEN=
TELEGRAM_SECRET=
PUBLIC_TELEGRAM_BOT=

# --- SMS ---------------------------------------------------------------------
# simulator: the /sim/sms page, no real network. For real SMS set
#SMS_MODE=smsethiopia andSMS_GATEWAY_TOKEN to the SMS Ethiopia
# campaign API key (https://smsethiopia.com, Console > API Keys).
SMS_MODE=simulator
SMS_GATEWAY_SECRET=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_URL=
SMS_CALLBACK_URL=
SMS_CALLBACK_SECRET=
SMS_DAILY_LIMIT=20

# --- Jobs --------------------------------------------------------------------
# Ethiojobs is imported from its public job pages. HahuJobs and Afriwork have
# no public feed: they stay "needs_setup" until the platform gives a partner
# feed URL (HAHUJOBS_FEED_URL /AFRIWORK_FEED_URL).
JOB_SOURCES=ethiojobs,hahujobs,afriwork
JOB_SYNC_LIMIT=40
# Job alerts are delivered natively by the Telegram bot and SMS. Run the alert
# job in-process every hour (0 = only via POST /v1/internal/alerts cron).
JOBS_ALERT_INTERVAL_MS=3600000
# Relay = an HTTPS webhook run by the HOST (e.g. ALX staff) that receives
# interview-support requests. Alerts do not need it (Telegram/SMS deliver them).
# Empty = the widget does not offer interview-support requests.
JOBS_RELAY_URL=
JOBS_RELAY_SECRET=
JOBS_RELAY_CHANNELS=

# --- Human help ----------------------------------------------------------------
HELPER_HOURS=
HELP_WAIT_TIMEOUT_MS=300000
# Metered TURN for video help behind strict NATs: both values from
# https://dashboard.metered.ca (app subdomain + secret key), or both empty to
# use public STUN.
TURN_APP=
TURN_API_KEY=

# --- LTI 1.3 (local demo platform) -------------------------------------------
LTI_PLATFORMS=[]
LTI_WIDGET_URL=
LTI_WIDGET_KEY=
