POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://dimts:replace-with-a-local-password@localhost:5432/dimts
DATABASE_URL_DIRECT=postgres://dimts:replace-with-a-local-password@localhost:5432/dimts
NODE_ENV=development
DIMTS_COMPOSE_API_PORT=3000
DIMTS_COMPOSE_WEB_PORT=5173
DIMTS_ENC_KEY=generate-with-openssl-rand-base64-32
DIMTS_HASH_KEY=generate-a-different-openssl-rand-base64-32
DIMTS_JWT_SECRET=generate-a-third-distinct-secret-at-least-32-characters
DIMTS_CRON_SECRET=generate-with-openssl-rand-base64-24
DIMTS_HOST_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DIMTS_PUBLIC_SOURCES=[]
# Generic LTI 1.3 platform metadata; values are public, not credentials.
DIMTS_PUBLIC_SOURCES=[]
DIMTS_SOURCE_SYNC_INTERVAL_MS=300000
DIMTS_LOCAL_WIDGET_KEY=local-widget-public-id
# Generate a random 32-byte base64url token before running pnpm seed.
DIMTS_SEED_HELPER_TOKEN=
DIMTS_DEFAULT_LANG=en
# Draft language packs this host publishes as beta (comma list). Amharic and
# Afaan Oromoo are still awaiting native-speaker review; listing them shows
# them to learners while review-gated features (FAQ, glossary mapping, voice)
# stay off. Leave empty to show reviewed or beta packs only.
DIMTS_PREVIEW_LANGS=am,om
# Supported voice adapters: none (default) or browser. Audio stays on device.
DIMTS_STT_ENGINE=none
DIMTS_TTS_ENGINE=none
# Development only (rejected in production): enable browser voice for packs
# whose device review is not recorded yet. Chrome speech recognition may send
# audio to the browser vendor's service.
DIMTS_VOICE_PREVIEW=false
DIMTS_RETENTION_HOURS=24
# Telegram stays disabled without a token. Leave the mode empty for the default:
# polling when NODE_ENV=development (no public URL needed; any webhook is
# removed automatically), webhook otherwise. Production rejects polling and
# needs DIMTS_TELEGRAM_SECRET plus /v1/telegram/webhook registered after deploy.
DIMTS_TELEGRAM_MODE=
# DIMTS_TELEGRAM_TOKEN=BotFather-token
# # Public username of the bot (without @), shown on the local demo page.
DIMTS_PUBLIC_TELEGRAM_BOT=
DIMTS_TELEGRAM_SECRET=generate-a-distinct-at-least-24-character-secret
# Local development may explicitly select polling; production rejects it.
# Host-managed delivery: URL and secret together; channels declare real host adapters.
# DIMTS_JOBS_RELAY_URL=https://host.example/dimts/delivery
# DIMTS_JOBS_RELAY_SECRET=generate-a-separate-at-least-24-character-secret
DIMTS_JOBS_RELAY_CHANNELS=
# Job platforms imported on API start and every DIMTS_JOB_SYNC_INTERVAL_MS
# (default 6 hours). Ethiojobs works out of the box from its public JobPosting
# pages. HahuJobs and Afriwork publish no public API or feed: they stay in
# "needs_setup" until the platform gives you a partner feed URL (and token).
DIMTS_JOB_SOURCES=ethiojobs,hahujobs,afriwork
DIMTS_JOB_SYNC_LIMIT=40
# Cloud speech (Google Gemini) for languages the browser cannot recognise or
# speak, used only after the learner allows cloud voice. Uses GEMINI_API_KEY.
DIMTS_CLOUD_VOICE=off
# DIMTS_HAHUJOBS_FEED_URL=https://partner-feed-from-hahujobs.example/jobs.json
# DIMTS_HAHUJOBS_FEED_TOKEN=
# DIMTS_AFRIWORK_FEED_URL=https://partner-feed-from-afriwork.example/jobs.json
# DIMTS_AFRIWORK_FEED_TOKEN=
# 0 uses the external authenticated /v1/internal/alerts scheduler.
DIMTS_JOBS_ALERT_INTERVAL_MS=0
# SMS simulator has no operator network delivery. Inbound stays disabled until a
# separate secret is configured; enter it manually in /sim/sms, never in HTML.
DIMTS_SMS_MODE=simulator
# DIMTS_SMS_GATEWAY_SECRET=generate-a-distinct-at-least-24-character-secret
DIMTS_SMS_DAILY_LIMIT=20
# SMS Ethiopia (https://smsethiopia.com): DIMTS_SMS_MODE=smsethiopia and put the
# campaign API key (Console > API Keys, 40 characters) in DIMTS_SMS_GATEWAY_TOKEN.
# The sender ID comes from the key's campaign. Trial (Default campaign) keys only
# deliver to numbers verified in the SMS Ethiopia dashboard (error 10007).
# DIMTS_SMS_MODE=smsethiopia
# DIMTS_SMS_GATEWAY_TOKEN=YOUR_SMSETHIOPIA_API_KEY
# Custom operator bridge (Dimts bridge protocol): gateway mode, URL and token together.
# DIMTS_SMS_GATEWAY_URL=https://operator.example/sms
# DIMTS_SMS_GATEWAY_TOKEN=generate-a-separate-operator-token-at-least-24-characters
# Optional host callback bridge receives a number only after separate Y consent.
# DIMTS_SMS_CALLBACK_URL=https://host.example/sms-callback
# DIMTS_SMS_CALLBACK_SECRET=generate-a-separate-callback-secret-at-least-24-characters
# UTC weekly intervals; unset = unrestricted, [] = unavailable.
# DIMTS_HELPER_HOURS=[{"day":1,"start":"09:00","end":"17:00"}]
DIMTS_HELP_WAIT_TIMEOUT_MS=300000
# Configure both for Metered temporary credentials; omit both for public STUN.
# DIMTS_TURN_APP=your-metered-app-subdomain
# DIMTS_TURN_API_KEY=server-only-metered-secret-key
# Citation links point at <base>/<lang>/<lesson>#<section>. The local web
# container serves rendered lessons at /learn/; content/savanna is ingested on
# API start when it changes.
DIMTS_CONTENT_BASE_URL=http://localhost:5173/learn/
DIMTS_AI_PROVIDER=offline
DIMTS_AI_LADDER=offline
# Remote providers answer only after the learner allows remote AI for the
# session; without consent the offline extractive provider answers. Add
# "job-posting" to allowedDataClasses to let it answer questions about imported
# public job postings. Example:
# GEMINI_API_KEY=...
# DIMTS_AI_PROVIDER=gemini-fast
# DIMTS_AI_LADDER=gemini-fast,offline
# DIMTS_AI_PROVIDERS=[{"id":"gemini-fast","adapter":"gemini","model":"gemini-3.1-flash-lite","credentialRef":"GEMINI_API_KEY","privacyClass":"remote","enabled":true,"priority":1,"timeoutMs":8000,"allowedDataClasses":["question","course-passage","job-posting"],"evaluatedLanguages":[],"capabilities":{"languages":["en","am","om"],"modes":["extractive","generative"],"modalities":["text"],"structuredOutput":true}}]
DIMTS_AI_PROVIDERS=[]
DIMTS_AI_MAX_TOKENS=512
# Retrieval floor when a consented AI provider judges passage relevance. Lower
# values help inflected languages such as Amharic reach the provider; the
# provider still returns not-found when the passages do not answer.
DIMTS_AI_RECALL_FLOOR=0.15
DIMTS_AI_TEMPERATURE=0.2
DIMTS_AI_CONSENT_VERSION=remote-ai-v1
DIMTS_LANGUAGE_DETECTION_CONFIDENCE=0.25
